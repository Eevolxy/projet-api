<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cooking Frenzy</title>
    <link rel="stylesheet" href="../static/css/home.css">
    <link rel="stylesheet" href="../static/css/recipeDetail.css">
    <link rel="icon" href="../static/img/logo-repas.jpg">

</head>

<body>

    <div id="search-bar">
        <input id="search-input" type="text" placeholder="Chercher une recette..." autocomplete="off">
    </div>
    <h1>Nos Recettes</h1>
    <div id="items" class="recipes-container">
        {{#each recipes}}
            <div class="recipe-card" onclick="window.location.href='/recipe/{{id}}'">
                <img src="{{image}}">
                <h3>{{title}}</h3>
            </div>
        {{/each}}
    </div>
    <img id="return-arrow" src="../static/img/return-arrow.png" alt="return arrow" class="hidden">
    <div id="recipe-detail" class="hidden"></div>


</body>
<script type="module" src="../static/js/script.js"></script>

</html>