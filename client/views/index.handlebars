<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cooking Frenzy</title>
    <link rel="stylesheet" href="../static/css/home.css">
    <link rel="icon" href="../static/img/logo-repas.jpg">

</head>

<body>
<header>
    <nav class="navbar">
        <div class="logo">
            Cooking Frenzy
        </div>
        {{#if isAdmin}}
        <button id="create-btn" onclick="window.location.href='/create-recipe'">
            🥘 Créer une recette
        </button>
        {{/if}}
        {{#if user}}
        <button id="login-btn" onclick="window.location.href='/logout'">
            🛜 Déconnexion
        </button>
        {{else}}
        <button onclick="window.location.href='/login'">
            🛜 Se connecter
        </button>
        {{/if}}
    </nav>
</header>
<div id="search-bar">
    <input id="search-input" aria-label="search-input" type="text" placeholder="Chercher une recette..."
           autocomplete="off">
</div>
<h1>Nos Recettes</h1>
<div id="items" class="recipes-container">
    {{#each recipes}}
        <div class="recipe-card" onclick="window.location.href='/recipe/{{id}}'">
            <img src="{{image}}" alt="Image de la recette">
            <h3>{{title}}</h3>
        </div>
    {{/each}}
</div>

<div id="no-results" style="display: none; text-align: center; padding: 20px; color: #666;">
    🍳 Aucune recette ne correspond à votre recherche.
</div>

</body>
<script type="module" src="../static/js/script.js"></script>

</html>